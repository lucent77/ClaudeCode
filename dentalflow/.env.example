#===============================================================================
# DentalFlow Environment Configuration
# Copy this file to .env and update with your values
#===============================================================================

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

#===============================================================================
# Database (MySQL - CyberPanel)
#===============================================================================
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Create database in CyberPanel: Databases → Create Database

DATABASE_URL="mysql://dentalflow_user:your_password_here@localhost:3306/dentalflow_db"

#===============================================================================
# Authentication (Auth.js v5 / NextAuth)
#===============================================================================
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-super-secret-key-here-generate-with-openssl"

# Auth.js trust host (required for reverse proxy)
AUTH_TRUST_HOST=true

# Session settings
AUTH_SESSION_MAX_AGE=2592000

#===============================================================================
# Socket.io Server
#===============================================================================
SOCKET_PORT=3001
CORS_ORIGIN=http://localhost:3000

#===============================================================================
# Email (Optional - for notifications)
#===============================================================================
# SMTP settings for sending notifications
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=noreply@dentalflow.local

#===============================================================================
# File Upload (Optional)
#===============================================================================
# Maximum file size in bytes (default: 10MB)
# MAX_FILE_SIZE=10485760

# Upload directory
# UPLOAD_DIR=/home/dentalflow/uploads

#===============================================================================
# Production Settings
#===============================================================================
# When deploying to production, update these values:
#
# NEXT_PUBLIC_APP_URL=https://your-domain.com
# NEXT_PUBLIC_SOCKET_URL=https://your-domain.com
# CORS_ORIGIN=https://your-domain.com
#
# For CyberPanel SSL:
# - Go to Websites → List Websites → Your Domain → SSL
# - Click "Issue SSL" button (uses Let's Encrypt)
#===============================================================================
