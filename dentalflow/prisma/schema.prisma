/**
 * Prisma Schema - DentalFlow CADCAM Management System
 *
 * Database: MySQL (CyberPanel default)
 * Features:
 * - Multi-department case management
 * - Real-time task tracking
 * - Custom fields and statuses per department
 * - Auth.js v5 integration
 */

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// Authentication Models (Auth.js v5 / NextAuth)
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  password      String?   // Hashed password for credentials auth
  image         String?   @db.Text
  role          UserRole  @default(TECHNICIAN)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  departmentId  String?
  department    Department?   @relation(fields: [departmentId], references: [id])
  assignedTasks Task[]        @relation("AssignedTasks")
  createdCases  Case[]        @relation("CreatedCases")
  comments      Comment[]
  activities    Activity[]
  notifications Notification[]

  @@index([email])
  @@index([departmentId])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// Core Business Models
// ============================================

enum UserRole {
  ADMIN       // Full system access
  MANAGER     // Department management
  TECHNICIAN  // Task execution
  VIEWER      // Read-only access
}

enum CaseStatus {
  RECEIVED      // Case received from client
  IN_PROGRESS   // Currently being processed
  ON_HOLD       // Temporarily paused
  COMPLETED     // All tasks done
  DELIVERED     // Sent to client
  CANCELLED     // Case cancelled
}

enum CasePriority {
  URGENT
  HIGH
  NORMAL
  LOW
}

enum TaskStatus {
  PENDING       // Not started
  IN_PROGRESS   // Currently being worked on
  REVIEW        // Awaiting review/approval
  COMPLETED     // Task finished
  BLOCKED       // Blocked by dependency
}

// Department - CAD, Milling, Sintering, Finishing, QC, etc.
model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique @db.VarChar(10)
  description String?  @db.Text
  color       String   @default("#3b82f6") // Hex color for UI
  icon        String?  // Icon name for UI
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  users         User[]
  tasks         Task[]
  taskTypes     TaskType[]
  customFields  CustomField[]
  customStatuses CustomStatus[]
  workflowSteps WorkflowStep[]

  @@index([code])
  @@map("departments")
}

// TaskType - Defines types of tasks per department
model TaskType {
  id           String   @id @default(cuid())
  departmentId String
  name         String
  description  String?  @db.Text
  defaultTime  Int?     // Estimated time in minutes
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  tasks      Task[]

  @@unique([departmentId, name])
  @@index([departmentId])
  @@map("task_types")
}

// CustomField - Department-specific custom fields
model CustomField {
  id           String          @id @default(cuid())
  departmentId String
  name         String
  label        String
  type         CustomFieldType
  options      Json?           // For select/multiselect types
  isRequired   Boolean         @default(false)
  sortOrder    Int             @default(0)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  // Relations
  department   Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  fieldValues  CustomFieldValue[]

  @@unique([departmentId, name])
  @@index([departmentId])
  @@map("custom_fields")
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  MULTISELECT
  CHECKBOX
  TEXTAREA
}

// CustomFieldValue - Stores values for custom fields
model CustomFieldValue {
  id            String   @id @default(cuid())
  customFieldId String
  taskId        String
  value         String   @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  customField CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  task        Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([customFieldId, taskId])
  @@index([taskId])
  @@map("custom_field_values")
}

// CustomStatus - Department-specific custom statuses
model CustomStatus {
  id           String   @id @default(cuid())
  departmentId String
  name         String
  label        String
  color        String   @default("#6b7280")
  sortOrder    Int      @default(0)
  isFinal      Boolean  @default(false) // Marks task as complete
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  tasks      Task[]

  @@unique([departmentId, name])
  @@index([departmentId])
  @@map("custom_statuses")
}

// Case - Main case/order from client
model Case {
  id            String       @id @default(cuid())
  caseNumber    String       @unique
  patientName   String?
  patientId     String?
  clientName    String
  clientId      String?
  description   String?      @db.Text
  status        CaseStatus   @default(RECEIVED)
  priority      CasePriority @default(NORMAL)
  dueDate       DateTime?
  receivedDate  DateTime     @default(now())
  completedDate DateTime?
  deliveredDate DateTime?
  notes         String?      @db.Text
  metadata      Json?        // Additional case metadata
  createdById   String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  createdBy   User        @relation("CreatedCases", fields: [createdById], references: [id])
  tasks       Task[]
  comments    Comment[]
  attachments Attachment[]
  activities  Activity[]

  @@index([caseNumber])
  @@index([status])
  @@index([clientName])
  @@index([dueDate])
  @@index([createdById])
  @@map("cases")
}

// Task - Individual task within a case
model Task {
  id             String      @id @default(cuid())
  caseId         String
  departmentId   String
  taskTypeId     String?
  customStatusId String?
  assigneeId     String?
  title          String
  description    String?     @db.Text
  status         TaskStatus  @default(PENDING)
  priority       CasePriority @default(NORMAL)
  estimatedTime  Int?        // Minutes
  actualTime     Int?        // Minutes
  startedAt      DateTime?
  completedAt    DateTime?
  dueDate        DateTime?
  sortOrder      Int         @default(0)
  metadata       Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Relations
  case           Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  department     Department         @relation(fields: [departmentId], references: [id])
  taskType       TaskType?          @relation(fields: [taskTypeId], references: [id])
  customStatus   CustomStatus?      @relation(fields: [customStatusId], references: [id])
  assignee       User?              @relation("AssignedTasks", fields: [assigneeId], references: [id])
  customFieldValues CustomFieldValue[]
  comments       Comment[]
  attachments    Attachment[]
  activities     Activity[]

  // Task dependencies
  dependsOn      TaskDependency[] @relation("DependentTask")
  dependedBy     TaskDependency[] @relation("DependencyTask")

  @@index([caseId])
  @@index([departmentId])
  @@index([assigneeId])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

// TaskDependency - Task dependency relationships
model TaskDependency {
  id           String @id @default(cuid())
  taskId       String
  dependsOnId  String
  createdAt    DateTime @default(now())

  task         Task @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn    Task @relation("DependencyTask", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
  @@map("task_dependencies")
}

// WorkflowStep - Defines workflow sequence for cases
model WorkflowStep {
  id           String   @id @default(cuid())
  departmentId String
  name         String
  description  String?  @db.Text
  stepOrder    Int
  isOptional   Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([departmentId, stepOrder])
  @@index([departmentId])
  @@map("workflow_steps")
}

// Comment - Comments on cases or tasks
model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  caseId    String?
  taskId    String?
  userId    String
  parentId  String?  // For threaded comments
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  case    Case?     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  task    Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id])
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  @@index([caseId])
  @@index([taskId])
  @@index([userId])
  @@map("comments")
}

// Attachment - File attachments
model Attachment {
  id        String   @id @default(cuid())
  filename  String
  filepath  String
  mimetype  String
  size      Int      // Bytes
  caseId    String?
  taskId    String?
  createdAt DateTime @default(now())

  // Relations
  case Case? @relation(fields: [caseId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([taskId])
  @@map("attachments")
}

// Activity - Activity log for audit trail
model Activity {
  id          String       @id @default(cuid())
  type        ActivityType
  description String       @db.Text
  metadata    Json?
  caseId      String?
  taskId      String?
  userId      String
  createdAt   DateTime     @default(now())

  // Relations
  case Case? @relation(fields: [caseId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User  @relation(fields: [userId], references: [id])

  @@index([caseId])
  @@index([taskId])
  @@index([userId])
  @@index([createdAt])
  @@map("activities")
}

enum ActivityType {
  CASE_CREATED
  CASE_UPDATED
  CASE_STATUS_CHANGED
  TASK_CREATED
  TASK_UPDATED
  TASK_STATUS_CHANGED
  TASK_ASSIGNED
  COMMENT_ADDED
  ATTACHMENT_ADDED
}

// Notification - User notifications
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_UPDATED
  TASK_COMPLETED
  CASE_UPDATED
  COMMENT_MENTION
  DEADLINE_APPROACHING
  SYSTEM_ALERT
}

// Client - Client/Dentist information
model Client {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique @db.VarChar(20)
  email       String?
  phone       String?
  address     String?  @db.Text
  contactName String?
  notes       String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([code])
  @@index([name])
  @@map("clients")
}

// Settings - System settings
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  type      String   @default("string")
  group     String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([group])
  @@map("settings")
}
