{
    "name": "creodent/work-manager",
    "description": "CREODENT Integrated Work Management System",
    "type": "project",
    "require": {
        "php": ">=8.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"copy('config/config.example.php', 'config/config.php');\""
        ]
    }
}
