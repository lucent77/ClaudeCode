{
    "name": "creodent/aox-dashboard",
    "description": "Creodent AoX Elevate Dashboard - Slack Integration for Dental Case Management",
    "type": "project",
    "keywords": ["dental", "case management", "slack", "dashboard"],
    "license": "MIT",
    "require": {
        "php": "^7.4|^8.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
