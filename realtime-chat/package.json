{
  "name": "realtime-chat",
  "version": "1.0.0",
  "description": "Slack-like realtime chat application optimized for CyberPanel/AlmaLinux9",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "build:css": "npx tailwindcss -i ./public/css/input.css -o ./public/css/styles.css --minify",
    "watch:css": "npx tailwindcss -i ./public/css/input.css -o ./public/css/styles.css --watch",
    "setup": "npm install && npm run build:css"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "better-sqlite3": "^9.2.2",
    "bcryptjs": "^2.4.3",
    "uuid": "^9.0.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.5",
    "sanitize-html": "^2.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "tailwindcss": "^3.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
