# Application
APP_ENV=development
APP_URL=http://localhost:8080
APP_DEBUG=true

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=creodent_voice
DB_USER=root
DB_PASS=

# Session
SESSION_SECRET=change-this-to-a-random-64-char-string

# Slack Integration (optional)
SLACK_WEBHOOK_URL=

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@creodent.com

# Security
RATE_LIMIT_POSTS=5
RATE_LIMIT_VOTES=10
UPLOAD_MAX_SIZE=3145728
