# =================================
# DentalFlow 환경변수 설정
# =================================
# 이 파일을 .env.local로 복사하여 실제 값을 입력하세요
# cp .env.example .env.local

# ---------------------------------
# Database (MySQL)
# ---------------------------------
# Hostinger VPS MySQL 연결 문자열
# 형식: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://dentalflow:your-password@localhost:3306/dentalflow"

# ---------------------------------
# NextAuth.js
# ---------------------------------
# 프로덕션 도메인 (https 포함)
NEXTAUTH_URL="http://localhost:3000"

# 세션 암호화 키 (32자 이상 랜덤 문자열)
# 생성 방법: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"

# ---------------------------------
# Socket.io (실시간 동기화)
# ---------------------------------
# 클라이언트에서 사용할 Socket.io 서버 URL
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"

# Socket.io 서버 포트
SOCKET_PORT=3001

# ---------------------------------
# Redis (선택사항 - 세션/캐시)
# ---------------------------------
# Socket.io Redis adapter 사용 시 설정
# REDIS_URL="redis://localhost:6379"

# ---------------------------------
# 애플리케이션 설정
# ---------------------------------
# 환경 (development, production, test)
NODE_ENV="development"

# 로그 레벨 (debug, info, warn, error)
LOG_LEVEL="info"

# 타임존
TZ="Asia/Seoul"
